map <leader>waq <Action>(UnsplitAll)
let g:WhichKeyDesc_window_unsplit_all = "<leader>waq Unsplit All Panels"

" Switch to Left Split
nnoremap <C-h> <C-w>h

" Switch to Right Split
nnoremap <C-l> <C-w>l

" Switch to Bottom Split
nnoremap <C-j> <C-w>j

" Switch to Top Split
nnoremap <C-k> <C-w>k

